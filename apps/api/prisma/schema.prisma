// LeadPilot schema v1 — fields, relations and indexes only (no business logic).
//
// Conventions
// - IDs are UUIDv7: time-ordered, so inserts stay index-friendly and ids sort
//   by creation time.
// - Every tenant table carries `workspaceId`, including child tables, so any
//   query can be scoped to a workspace without a join (see CLAUDE.md, Tenancy).
// - Global tables (no workspaceId): User, PromptVersion, Enrichment (public
//   website data cached per domain).
// - Same-workspace references: a child points at its parent with a composite
//   foreign key (parentId, workspaceId) -> parent (id, workspaceId), so
//   Postgres itself rejects a row in workspace A pointing at workspace B.
//   Optional composite relations use onDelete NoAction: SetNull would also
//   null workspaceId, so the service deleting the parent clears the reference
//   with the scalar (`ownerId: null`), never `disconnect`, which would try to
//   null workspaceId too. Composite relations use onUpdate Restrict: a row
//   never moves between workspaces.
// - Actor columns (Feedback.userId, LeadEvent.actorUserId,
//   AuditLog.actorUserId) have no foreign key on purpose: history must survive
//   member removal. Set them only from the session, never from request input.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql" // URL comes from prisma.config.ts
}

/// UI language. Values are the i18n locale codes the web app uses.
enum Locale {
  en
  vi
}

/// ISO 4217. VND has no minor units.
enum Currency {
  USD
  VND
}

/// Change history filter (Settings > Change history).
enum AuditArea {
  rules
  sources
  ideal_customer
  integrations
  team
  general
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SourceType {
  WEBHOOK
  FORM
  CSV
}

/// Where the lead is in the processing pipeline.
enum LeadStatus {
  NEW
  PROCESSING
  NEEDS_REVIEW
  ROUTED
  FAILED
}

/// What sales did with the lead (set by reps).
enum LeadOutcome {
  NONE
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadTier {
  HOT
  WARM
  COLD
  JUNK
}

enum IntegrationType {
  EMAIL
  SLACK
  TELEGRAM
  HUBSPOT
  WEBHOOK
}

enum ActionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

// ─── Tenancy & identity ─────────────────────────────────────────────────────

model Workspace {
  id                String   @id @default(uuid(7)) @db.Uuid
  name              String
  slug              String   @unique
  /// ISO-3166 alpha-2, used as the default region for E.164 phone parsing.
  defaultCountry    String?  @db.Char(2)
  /// Scores below this confidence go to the review queue.
  reviewThreshold   Float    @default(0.6)
  /// Used when a member has no saved `User.locale`, and for outgoing email.
  defaultLocale     Locale   @default(en)
  /// Currency of deal values and revenue. AI cost is always USD.
  currency          Currency @default(USD)
  /// IANA name, e.g. "Asia/Ho_Chi_Minh"; daily totals and history times use it.
  timezone          String   @default("UTC")
  /// Monthly AI cost limit; null means no limit. Enforced from M3.
  aiMonthlyLimitUsd Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships  Membership[]
  teams        Team[]
  sources      Source[]
  leads        Lead[]
  invites      Invite[]
  icpRubric    IcpRubric?
  routingRules RoutingRule[]
  integrations Integration[]
  auditLogs    AuditLog[]
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased (CHECK constraint in the migrations).
  email        String   @unique
  passwordHash String
  name         String?
  /// Saved language choice; null means use the workspace default.
  locale       Locale?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
  invitesSent   Invite[]       @relation("InviteInvitedBy")
}

model Membership {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @db.Uuid
  userId       String    @db.Uuid
  /// One OWNER per workspace (partial unique index in the migrations).
  role         Role      @default(MEMBER)
  /// "Last active" on the Team page; bumped at most once a minute.
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams         TeamMember[]
  ownedLeads    Lead[]         @relation("LeadOwner")
  refreshTokens RefreshToken[]

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([userId])
}

model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
}

/// Not in SPEC §6: needed for round-robin assignment within a team.
model TeamMember {
  teamId         String    @db.Uuid
  membershipId   String    @db.Uuid
  workspaceId    String    @db.Uuid
  /// Round-robin cursor (M4): the member assigned longest ago goes next.
  lastAssignedAt DateTime?

  team       Team       @relation(fields: [teamId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)
  membership Membership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)

  @@id([teamId, membershipId])
  @@index([workspaceId])
  @@index([membershipId])
}

model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  /// Stored lowercased (CHECK constraint). One pending invite per address and
  /// workspace (partial unique index); resending rotates the token in place.
  email       String
  role        Role      @default(MEMBER)
  /// SHA-256 of the random token in the link (high entropy, so no slow hash).
  tokenHash   String    @unique
  /// Null once the inviting user's account is deleted.
  invitedById String?   @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([invitedById])
}

/// A session belongs to one workspace: removing the membership deletes it.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  /// All tokens from one login share a family; reuse of a rotated token revokes the family.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@index([workspaceId, userId])
  @@index([familyId])
}

// ─── Ingestion ──────────────────────────────────────────────────────────────

model Source {
  id            String     @id @default(uuid(7)) @db.Uuid
  workspaceId   String     @db.Uuid
  name          String
  type          SourceType
  /// Public part of the API key: shown in the UI and used to look the key up.
  apiKeyPrefix  String     @unique
  /// SHA-256 of the full key (high-entropy random key, so no slow hash needed).
  apiKeyHash    String
  /// AES-256-GCM encrypted.
  hmacSecretEnc String?
  enabled       Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads           Lead[]
  idempotencyKeys IdempotencyKey[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  workspaceId    String   @db.Uuid
  sourceId       String   @db.Uuid
  key            String
  /// Same key with a different body is rejected (422) instead of replayed.
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  /// createdAt + 24h.
  expiresAt      DateTime

  source Source @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([sourceId, key])
  @@index([expiresAt])
}

// ─── Leads ──────────────────────────────────────────────────────────────────

/// One deduplicated person. Each submission's raw payload is kept as a
/// LeadEvent ("ingested"); `rawPayload` holds the latest one.
model Lead {
  id           String      @id @default(uuid(7)) @db.Uuid
  workspaceId  String      @db.Uuid
  /// Source of the first submission; later sources appear in events.
  sourceId     String      @db.Uuid
  /// Stored lowercased; a CHECK constraint in the migrations enforces it, so
  /// the dedup guard below cannot be bypassed by letter case.
  email        String?
  /// E.164.
  phone        String?
  firstName    String?
  lastName     String?
  company      String?
  domain       String?
  country      String?     @db.Char(2)
  customFields Json        @default("{}")
  rawPayload   Json
  status       LeadStatus  @default(NEW)
  outcome      LeadOutcome @default(NONE)
  /// Deal size once known, in the workspace's currency; used for revenue by source.
  dealValue    Decimal?    @db.Decimal(14, 2)
  tier         LeadTier?
  score        Int?
  confidence   Float?
  isFreeMail   Boolean     @default(false)
  /// The owner's userId; must be a member of this workspace (composite FK to
  /// Membership). Removing the member clears it in the service.
  ownerId      String?     @db.Uuid
  /// e.g. { "hubspot": "123" }
  externalIds  Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source     Source      @relation(fields: [sourceId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  owner      Membership? @relation("LeadOwner", fields: [workspaceId, ownerId], references: [workspaceId, userId], onDelete: NoAction, onUpdate: Restrict)
  events     LeadEvent[]
  scores     Score[]
  actionRuns ActionRun[]
  feedback   Feedback[]

  /// DB-level dedup guard: two concurrent ingests cannot create the same email twice.
  /// Postgres allows many NULLs, so leads without email are unaffected.
  @@unique([workspaceId, email])
  @@unique([id, workspaceId])
  @@index([workspaceId, phone])
  @@index([workspaceId, domain])
  /// Overview charts (leads per day, junk rate) and the unfiltered leads list.
  @@index([workspaceId, createdAt])
  /// Leads list filters and the review queue (status = NEEDS_REVIEW): filter,
  /// then sort and paginate by date from the same index, without a sort step.
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, tier, createdAt])
  @@index([workspaceId, ownerId, createdAt])
  @@index([workspaceId, sourceId, createdAt])
}

/// Timeline entry. `type` is a string ("ingested", "merged", "enriched", ...)
/// so new event kinds need no migration.
model LeadEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  leadId      String   @db.Uuid
  type        String
  /// Event details. Not named `data`: that is a Prisma argument keyword, and
  /// the workspace scope walks keywords (see workspace-scope.ts).
  payload     Json     @default("{}")
  /// Null means the system did it.
  /// Actor id with no FK, so history survives member removal (see header).
  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)

  @@index([workspaceId, leadId, createdAt])
}

// ─── Pipeline: enrichment & scoring ─────────────────────────────────────────

/// Global cache (not per workspace): holds only public website metadata.
model Enrichment {
  id        String   @id @default(uuid(7)) @db.Uuid
  domain    String   @unique
  provider  String
  data      Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// Global, versioned prompts. Workspaces customize scoring via IcpRubric.
model PromptVersion {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// e.g. "lead-score"
  name      String
  version   Int
  template  String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  scores Score[]

  @@unique([name, version])
}

model Score {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @db.Uuid
  leadId          String   @db.Uuid
  promptVersionId String   @db.Uuid
  /// "anthropic" | "openai" | "mock" | "rules"
  provider        String
  model           String
  /// The validated LLM JSON.
  output          Json
  score           Int
  tier            LeadTier
  confidence      Float
  isSpam          Boolean
  /// True when the rule-based fallback produced this score.
  isFallback      Boolean  @default(false)
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  costUsd         Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs       Int
  createdAt       DateTime @default(now())

  lead          Lead          @relation(fields: [leadId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)
  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  feedback      Feedback[]

  @@unique([id, workspaceId])
  @@unique([id, leadId, workspaceId])
  @@index([workspaceId, leadId, createdAt])
  @@index([workspaceId, createdAt])
}

model IcpRubric {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @unique @db.Uuid
  industries    String[]
  /// e.g. ["11-50", "51-200"]
  companySizes  String[]
  countries     String[]
  budgetSignals String[]
  disqualifiers String[]
  notes         String?
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Human override of an AI score; used as labels by the eval script.
model Feedback {
  id            String    @id @default(uuid(7)) @db.Uuid
  workspaceId   String    @db.Uuid
  leadId        String    @db.Uuid
  scoreId       String?   @db.Uuid
  /// Actor id with no FK, so history survives member removal (see header).
  userId        String    @db.Uuid
  previousTier  LeadTier?
  previousScore Int?
  newTier       LeadTier
  newScore      Int?
  note          String?
  createdAt     DateTime  @default(now())

  lead  Lead   @relation(fields: [leadId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)
  /// The score being corrected: same lead, same workspace.
  score Score? @relation(fields: [scoreId, leadId, workspaceId], references: [id, leadId, workspaceId], onDelete: NoAction, onUpdate: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, leadId])
  @@index([workspaceId, scoreId])
}

// ─── Routing & actions ──────────────────────────────────────────────────────

model RoutingRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  /// Evaluated ascending; first match wins (unless alwaysRun).
  order       Int
  /// Validated by a shared zod schema.
  conditions  Json
  actions     Json
  enabled     Boolean  @default(true)
  alwaysRun   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionRuns ActionRun[]

  @@unique([id, workspaceId])
  @@index([workspaceId, order])
}

model Integration {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @db.Uuid
  type        IntegrationType
  name        String
  /// AES-256-GCM encrypted JSON config (tokens, webhook URLs).
  configEnc   String
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionRuns ActionRun[]

  @@unique([id, workspaceId])
  @@index([workspaceId, type])
}

model ActionRun {
  id            String       @id @default(uuid(7)) @db.Uuid
  workspaceId   String       @db.Uuid
  leadId        String       @db.Uuid
  ruleId        String?      @db.Uuid
  integrationId String?      @db.Uuid
  /// "assign" | "email" | "slack" | ...
  type          String
  /// leadId + step: makes the job idempotent (a retry cannot create a second run).
  jobKey        String       @unique
  status        ActionStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  payload       Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lead        Lead         @relation(fields: [leadId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Restrict)
  rule        RoutingRule? @relation(fields: [ruleId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: Restrict)
  integration Integration? @relation(fields: [integrationId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: Restrict)

  @@index([workspaceId, leadId])
  @@index([workspaceId, status])
  @@index([workspaceId, ruleId])
  @@index([workspaceId, integrationId])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @db.Uuid
  /// Actor id with no FK, so history survives member removal (see header).
  actorUserId String?   @db.Uuid
  area        AuditArea
  /// e.g. "routing_rule.updated"
  action      String
  entityType  String
  entityId    String?
  before      Json?
  /// Secrets are redacted before writing.
  after       Json?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, area, createdAt])
  @@index([workspaceId, entityType, entityId])
}
