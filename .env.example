# Copy to .env at the repo root. Values below match docker-compose.yml.
# With these defaults (and no provider keys) the app runs in demo mode.

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=3001
# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://leadpilot:leadpilot@localhost:5432/leadpilot
# Used by e2e tests only; reset on every run
DATABASE_URL_TEST=postgresql://leadpilot:leadpilot@localhost:5432/leadpilot_test

# --- Redis (health check now, BullMQ in M3) ---
REDIS_URL=redis://localhost:6379

# --- Email (Mailpit locally: UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave SMTP_HOST empty to skip real sending (invites are kept in memory only).
EMAIL_FROM="LeadPilot <no-reply@leadpilot.local>"

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth ---
# Required in production (32+ characters, e.g. `openssl rand -base64 48`).
# Left unset in development, a fixed dev-only secret is used.
# JWT_ACCESS_SECRET=
# Login/signup/refresh/accept-invite requests per minute per IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Refresh runs on every page load, so it has its own, larger budget.
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=60
# Invite/resend requests per workspace (they send email; up to 20 addresses each).
INVITE_RATE_LIMIT_PER_MINUTE=5
INVITE_RATE_LIMIT_PER_DAY=30

# --- Added in later milestones ---
# Encrypts secrets kept in the database (AES-256-GCM): 32 random bytes in base64.
# Optional in development (a dev-only key is used); required in production, and
# the app refuses to start without a valid one. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit it or print it: losing or changing it makes stored secrets unreadable.
# ENCRYPTION_KEY=
# Background jobs run inside the API process. "off" only queues them (a second process can do the work).
# QUEUE_WORKERS=on
# Company info for each lead: "mock" (made-up, no network; the default) or "website" (reads the
# lead's company homepage; public internet addresses only).
# ENRICHMENT_PROVIDER=mock
# Which AI rates the leads: auto (default) uses a real one only if its key below is set, else the free built-in mock.
# LLM_PROVIDER=auto
# LLM_MODEL=                  (optional; defaults: claude-haiku-5-5 for Anthropic, gpt-4o-mini for OpenAI)
# ANTHROPIC_API_KEY=          (optional; the app runs on the mock without it)
# OPENAI_API_KEY=             (optional)
