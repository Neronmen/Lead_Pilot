# Copy to .env at the repo root. Values below match docker-compose.yml.
# With these defaults (and no provider keys) the app runs in demo mode.

NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
API_PORT=3001
# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://leadpilot:leadpilot@localhost:5432/leadpilot
# Used by e2e tests only; reset on every run
DATABASE_URL_TEST=postgresql://leadpilot:leadpilot@localhost:5432/leadpilot_test

# --- Redis (health check now, BullMQ in M3) ---
REDIS_URL=redis://localhost:6379

# --- Email (Mailpit locally: UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Added in later milestones ---
# JWT_ACCESS_SECRET=          (M1)
# ENCRYPTION_KEY=             (M2, 32 bytes base64, AES-256-GCM)
# ANTHROPIC_API_KEY=          (M3, optional — mock provider used when empty)
# OPENAI_API_KEY=             (M3, optional)
