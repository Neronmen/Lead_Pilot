# Copy to .env.production (next to docker-compose.yml) and fill in. Never commit the real file.
# Two names that point at this server (an A record each): the web app and the API.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Secrets. Make each with: openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
# Exactly 32 random bytes in base64. Losing or changing it makes every stored token unreadable: back it up.
ENCRYPTION_KEY=

# Real email (invites, password reset, Hot lead alerts). Brevo's free plan: smtp-relay.brevo.com, 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LeadPilot <no-reply@your-domain.com>"

# Real AI. Leave LLM_PROVIDER=auto and set ONE key, or pick gemini / anthropic / openai explicitly.
LLM_PROVIDER=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MONTHLY_LIMIT_USD=5

# Slack, Telegram and webhooks are real in production. Each customer connects their own in the app.
ACTIONS_MODE=live
ENRICHMENT_PROVIDER=website
API_DOCS=off
NEXT_PUBLIC_DEMO_LOGIN=off
